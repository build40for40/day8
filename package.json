{
  "name": "handup",
  "private": true,
  "version": "0.0.1",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @handup/agent",
    "dev:web": "npm run dev -w @handup/web",
    "db:migrate": "npm run db:migrate -w @handup/agent",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "allowScripts": {
    "workerd@1.20261110.1": true,
    "esbuild@0.28.2": true
  }
}
