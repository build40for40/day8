{
  "name": "@handup/agent",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run wrangler -- dev",
    "deploy": "npm run wrangler -- d1 migrations apply handup --remote && npm run wrangler -- deploy",
    "wrangler": "env -u CLOUDFLARE_API_KEY -u CLOUDFLARE_EMAIL wrangler --profile 40for40",
    "types": "wrangler types src/worker-configuration.d.ts --env-file .dev.vars.example",
    "db:migrate": "npm run wrangler -- d1 migrations apply handup --local",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.102",
    "ai": "^7.0.169",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
